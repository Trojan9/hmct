# Copy to .env and adjust as needed.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://tasks:tasks@localhost:5432/tasks?schema=public
# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Requests allowed per client per 15 minutes on /api
RATE_LIMIT_MAX=300
